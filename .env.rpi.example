RPI_HOST=192.168.110.1
RPI_USER=pi
# Optional password mode. Quote passwords that contain shell characters.
RPI_PASSWORD=
# Optional. Defaults to RPI_PASSWORD when omitted.
RPI_SUDO_PASSWORD=
# Optional. Prefer an SSH key instead of a password when possible.
RPI_SSH_KEY=
RPI_PORT=22
RPI_APP_DIR=/opt/knx-tuya-gw

# Gitee HTTPS publishing. Use a personal access token instead of the login password.
GITEE_USERNAME=mvptianyu
GITEE_TOKEN=
GITEE_GIT_AUTHOR_NAME=mvptianyu
GITEE_GIT_AUTHOR_EMAIL=ly_258@126.com
GITEE_REMOTE=https://gitee.com/mvptianyu/config-gateway.git
GITEE_BRANCH=master
GITEE_BUNDLE_PATH=knx/knx-mapping.json
